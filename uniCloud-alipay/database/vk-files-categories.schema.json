    "sort": {
      "title": "排序值",
      "bsonType": "int",
      "defaultValue": 0
    },
    "category_type": {
      "title": "分类类型",
      "bsonType": "string"
    },
    "customer_id": {
      "title": "客户ID",
      "bsonType": "string"
    },
    "is_system": {
      "title": "是否系统目录",
